{
  "name": "cortisol-x",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4317",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4317",
    "app:start": "electron . --dev",
    "desktop": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./tests/setup.cjs --test tests/*.test.ts",
    "browser": "node scripts/start-browser.cjs",
    "dist:win": "npm run build && node scripts/prepare-package.cjs && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@pump-fun/pump-sdk": "^4.3.1",
    "@pump-fun/pump-swap-sdk": "^2.2.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "better-sqlite3": "^12.4.1",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.12",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "electron": "^39.0.0",
    "electron-builder": "^26.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.0"
  },
  "description": "Cortisol.x local Solana research and execution terminal",
  "author": "Cortisol.x"
}
